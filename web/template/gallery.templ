package template

import (
	"github.com/agiannif/adistantcloud/internal/config"
	"strconv"
)

templ Gallery(gallery *config.GalleryConfig, galleries []config.GalleryMetadata) {
	@page() {
		@nav("/gallery/"+gallery.Metadata.ShortName, "a distant cloud", galleries)
		<header class="max-w-7xl mx-auto px-6 flex justify-center">
			<h1 class="text-7xl font-light font-title">
				{ gallery.Metadata.Name }
			</h1>
		</header>
		<div class="gallery-layout">
			<div
				class="gallery-grid"
				x-data="{
					activeSection: section1,
					sections: document.querySelectorAll('h2[id^=section]'),
					galleryNavExpanded: false,
					updateGalleryNav() {
						// calculate distance of all gallery sections
            let midScreen = window.innerHeight / 2
            let sectionsByDistanceFromTop = {}
            this.sections.forEach(section => {
                sectionsByDistanceFromTop[section.getBoundingClientRect().top - midScreen] = section
            })

            // find the section that is the closest and above the midpoint
            let closestNegativeTop = Math.max(...Object.keys(sectionsByDistanceFromTop).filter(top => top < 0))
            if (closestNegativeTop >= 0 || [Infinity, NaN, -Infinity].includes(closestNegativeTop)) {
						  return this.activeSection = section1
						}
            this.activeSection = sectionsByDistanceFromTop[closestNegativeTop].id
					},
					toggleMobileGalleryNav() {
						this.galleryNavExpanded = !this.galleryNavExpanded;
						this.galleryNavExpanded ? this.lockScroll() : this.unlockScroll();
					},
					// Scrolling stays locked while anything holds a lock, so closing the nav
					// cannot unlock the page under an open viewer, or the reverse.
					scrollLocks: 0,
					lockScroll() {
						if (this.scrollLocks++ === 0) {
							document.body.classList.add('h-full', 'overflow-y-hidden');
						}
					},
					unlockScroll() {
						if (--this.scrollLocks === 0) {
							document.body.classList.remove('h-full', 'overflow-y-hidden');
						}
					},
					// Fullscreen viewer shared by every image: a thumbnail names its largest
					// variant in data-fullscreen-src.
					viewer: { open: false, src: null, alt: '', width: null, height: null },
					viewerHideTimer: null,
					openViewer(image) {
						if (this.viewer.open) return;
						clearTimeout(this.viewerHideTimer);
						this.viewer = { open: true, src: image.dataset.fullscreenSrc, alt: image.alt, width: image.getAttribute('width'), height: image.getAttribute('height') };
						this.lockScroll();
					},
					closeViewer() {
						if (!this.viewer.open) return;
						this.viewer.open = false;
						this.unlockScroll();
						// keep the image until the leave transition ends so it fades out, then drop it
						// so the next photo does not flash the previous one
						this.viewerHideTimer = setTimeout(() => { this.viewer.src = null }, 450);
					}
				}"
				x-init="updateGalleryNav()"
				@scroll.window.throttle.50ms="updateGalleryNav()"
			>
				<div class="hidden full:inline">
					@galleryNav(gallery)
				</div>
				<div class="inline full:hidden">
					@mobileGalleryNav(gallery)
				</div>
				<main class="p-6 grid grid-cols-79 gap-y-3 place-items-center">
					{{ currentSection := 0 }}
					{{ firstImageRow := firstImageRowIndex(gallery.Rows) }}
					for i, row := range gallery.Rows {
						@galleryRow(row, currentSection, i == firstImageRow)
						if row.Layout == config.LayoutSection {
							{{ currentSection++ }}
						}
					}
					@goToTopButton()
				</main>
				// fullscreen viewer, shared by every image
				<div
					x-show="viewer.open"
					x-cloak
					@click="closeViewer()"
					@keyup.escape.window="closeViewer()"
					class="fixed inset-0 z-50 flex items-center justify-center cursor-pointer bg-white/[.98] touch-none"
				>
					<img
						x-show="viewer.open"
						x-transition:enter.duration.500ms
						x-transition:leave.duration.400ms
						:src="viewer.src"
						:alt="viewer.alt"
						:width="viewer.width"
						:height="viewer.height"
						decoding="async"
						class="max-h-screen max-w-screen object-contain touch-none"
					/>
				</div>
			</div>
		</div>
		@footer()
		<div class="mb-16 full:hidden"></div>
	}
}

templ galleryNav(gallery *config.GalleryConfig) {
	<nav class="fixed top-1/4 px-6 py-1 ml-3 border-l-2 border-l-ef-light-gray">
		<ul class="space-y-2">
			{{ currentSection := 0 }}
			for _, row := range gallery.Rows {
				if row.Layout == config.LayoutSection {
					<li>
						<a
							href={ templ.URL("#section" + strconv.Itoa(currentSection)) }
							class="text-ef-light-gray hover:text-ef-light-purple transition-colors duration-300"
							:class={ "activeSection === 'section" + strconv.Itoa(currentSection) + "' && '-ml-4 text-ef-light-purple'" }
						>
							{ row.ShortTitle }
						</a>
					</li>
					{{ currentSection++ }}
				}
			}
		</ul>
	</nav>
}

templ mobileGalleryNav(gallery *config.GalleryConfig) {
	<nav
		class="fixed transition-all duration-300 bg-ef-light-bg-dim z-50 left-0 right-0 bottom-0"
		:class="galleryNavExpanded ? 'h-full' : 'h-16 top-shadow-md'"
		x-transition
	>
		<div
			class="max-w-7xl mx-auto px-6 py-3 overflow-y-auto"
			:class="galleryNavExpanded && 'h-full flex flex-col'"
		>
			// collapsed header, when nav is minimized
			<div
				x-show="!galleryNavExpanded"
				@click="toggleMobileGalleryNav()"
				class="flex items-center justify-between w-full cursor-pointer"
			>
				<div class="flex items-center w-full gap-6 text-ef-light-fg text-lg border-l-2 border-l-ef-light-gray">
					@displayActiveSectionTitle(gallery)
				</div>
			</div>
			// expanded view close button
			<button
				x-show="galleryNavExpanded"
				@click="toggleMobileGalleryNav()"
				class="self-end text-ef-light-gray hover:text-ef-light-purple p-2 mb-4"
			>
				Close
			</button>
			// section links
			<div
				class="mt-3 flex flex-col gap-3 text-ef-light-fg text-lg border-l-2 border-l-ef-light-gray transition duration-300 px-6 touch-none"
				:class="galleryNavExpanded || 'h-0 overflow-hidden'"
			>
				@sectionLinks(gallery)
			</div>
		</div>
	</nav>
}

templ displayActiveSectionTitle(gallery *config.GalleryConfig) {
	{{ currentSection := 0 }}
	for _, row := range gallery.Rows {
		if row.Layout == config.LayoutSection {
			<p
				class="text-ef-light-purple underline ml-2"
				:class={ "activeSection === 'section" + strconv.Itoa(currentSection) + "' || 'hidden'" }
			>
				{ row.ShortTitle }
			</p>
			{{ currentSection++ }}
		}
	}
}

templ sectionLinks(gallery *config.GalleryConfig) {
	{{ currentSection := 0 }}
	for _, row := range gallery.Rows {
		if row.Layout == config.LayoutSection {
			<a
				href={ templ.URL("#section" + strconv.Itoa(currentSection)) }
				class="text-ef-light-gray hover:text-ef-light-purple transition-colors duration-300"
				:class={ "activeSection === 'section" + strconv.Itoa(currentSection) + "' && '-ml-4 text-ef-light-purple'" }
				@click="toggleMobileGalleryNav()"
			>
				{ row.ShortTitle }
			</a>
			{{ currentSection++ }}
		}
	}
}

templ goToTopButton() {
	<div
		x-data="{ atTop: true }"
		@scroll.window="atTop = (window.pageYOffset < 10) ? true : false"
	>
		<button
			x-show="!atTop"
			x-cloak
			x-transition
			@click="window.scrollTo({top: 0, behavior: 'smooth'})"
			class="fixed bottom-24 right-8 z-25 p-3 rounded-full bg-ef-light-gray-dim hover:bg-ef-light-gray active:bg-ef-light-gray-light text-ef-light-bg-light focus:outline-none focus:ring-2 focus:ring-ef-light-blue/75 transition-all cursor-pointer"
		>
			<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
			</svg>
		</button>
	</div>
}

templ galleryRow(row config.RowConfig, currentSection int, hasFirstImage bool) {
	if row.Layout == config.LayoutSection {
		@sectionHeader(row.Title, currentSection)
	} else {
		@imageRow(row, hasFirstImage)
	}
}

templ sectionHeader(title string, currentSection int) {
	<div class="col-span-full w-full flex flex-col gap-1 mt-12">
		<h2
			id={ "section" + strconv.Itoa(currentSection) }
			class="self-start -ml-4 text-ef-light-gray text-lg scroll-m-16"
		>
			{ title }
		</h2>
		<hr class="w-full border-t-2 border-ef-light-gray"/>
	</div>
}

// imageRow renders a row of images. The first image of the gallery is loaded
// eagerly, as it is the largest thing on screen when the page opens; every other
// image is loaded as it nears the viewport.
templ imageRow(row config.RowConfig, hasFirstImage bool) {
	{{ gridConfigs := getGridConfigs(row.Layout) }}
	for i, image := range row.Images {
		{{ eager := hasFirstImage && i == 0 }}
		{{ srcset := imageSrcset(image) }}
		{{ sizes := imageSizes(gridConfigs[i].Span) }}
		{{ fullscreenSrc := largestImageURL(image) }}
		<div
			class={ "md:col-span-" + gridConfigs[i].Span + " md:col-start-" + gridConfigs[i].Start + " col-span-79 col-start-1 bg-ef-light-bg-dim w-full" }
		>
			if eager {
				// in the markup so the browser fetches it before any script runs. It fades
				// in like the others, but may finish loading before Alpine attaches its
				// load handler, so Alpine also checks on init whether it already has.
				<img
					@click="openViewer($el)"
					data-fullscreen-src={ fullscreenSrc }
					@load="$el.style.opacity=1"
					x-init="if ($el.complete) $el.style.opacity = 1"
					class="transition duration-300 opacity-0 cursor-pointer"
					srcset={ srcset }
					sizes={ sizes }
					fetchpriority="high"
					alt={ image.Alt }
					width={ strconv.Itoa(image.Width) }
					height={ strconv.Itoa(image.Height) }
				/>
			} else {
				<img
					@click="openViewer($el)"
					data-fullscreen-src={ fullscreenSrc }
					@load="$el.style.opacity=1"
					class="transition duration-300 opacity-0 cursor-pointer"
					x-intersect.once.margin.200px={ "$el.srcset = '" + srcset + "'" }
					sizes={ sizes }
					decoding="async"
					alt={ image.Alt }
					width={ strconv.Itoa(image.Width) }
					height={ strconv.Itoa(image.Height) }
				/>
			}
		</div>
	}
}

type GridConfig struct {
	Start string
	Span  string
}

var layoutGridConfigs = map[config.Layout][]GridConfig{
	config.LayoutFull:      {{"1", "79"}},
	config.LayoutHalf:      {{"1", "39"}, {"41", "39"}},
	config.LayoutSplit:     {{"1", "54"}, {"56", "24"}},
	config.LayoutFlipSplit: {{"1", "24"}, {"26", "54"}},
	config.LayoutCenter:    {{"21", "39"}},
}

func getGridConfigs(layout config.Layout) []GridConfig {
	if configs, ok := layoutGridConfigs[layout]; ok {
		return configs
	}
	return []GridConfig{}
}
